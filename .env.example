# --- Arrestruct (produk desktop) ---------------------------------------------
# Pautan muat turun .exe. CADANGAN: GitHub Releases, bukan folder repo —
# fail ~36 MB menghampiri had deployment Vercel (50 MB).
# Contoh:
#   https://github.com/radzmil/arrestruct-releases/releases/download/v1.0.0/Arrestruct.exe
ARRESTRUCT_DOWNLOAD_URL=

# Nombor WhatsApp untuk pesanan lesen (tanpa '+' dan tanpa sengkang).
ARRESTRUCT_WHATSAPP=60183172114

# Versi dan saiz yang dipaparkan pada halaman muat turun.
ARRESTRUCT_VERSION=1.0.0
ARRESTRUCT_SIZE_MB=36

# Harga pakej dalam RM. Kosongkan untuk papar "Price on request".
ARRESTRUCT_PRICE_TRIAL=0
ARRESTRUCT_PRICE_PERSONAL=
ARRESTRUCT_PRICE_BUSINESS=
